def adapt_data_for_frontend(real_market_data: Dict) -> Dict:
    """Transform REAL market data for frontend"""
    adapted_data = {}
    
    for symbol, data in real_market_data.items():
        try:
            price = data.get('price', 0)
            change = data.get('change', 0)
            volatility = data.get('volatility', 0)
            volume = data.get('volume', 0)
            
            # Store for consistency
            dashboard.last_prices[symbol] = price
            
            display_symbol = symbol.replace('=X', '').replace('-USD', '')
            
            # Proper price formatting based on asset type
            if data.get('asset_type') == 'forex':
                formatted_price = f"{price:.5f}"
            elif data.get('asset_type') == 'crypto' and price < 1:
                formatted_price = f"{price:.4f}"
            elif data.get('asset_type') == 'crypto':
                formatted_price = f"{price:.2f}"
            else:
                formatted_price = f"{price:.2f}"
            
            adapted_data[symbol] = {
                'symbol': symbol,
                'display_symbol': display_symbol,
                'current_price': price,
                'price': price,
                'change': change,
                'change_percent': change,
                'movement': 'Up' if change >= 0 else 'Down',
                'movement_class': 'up' if change >= 0 else 'down',
                'volatility': volatility,
                'volatility_class': 'volatility-high' if volatility > 3 else 'volatility-medium' if volatility > 1.5 else 'volatility-low',
                'volatility_indicator': 'High' if volatility > 3 else 'Medium' if volatility > 1.5 else 'Low',
                'trend_strength': min(0.9, 0.5 + abs(change) / 10),  # Based on actual change
                'volume': volume,
                'formatted_volume': f"{volume:,.0f}" if volume > 1000 else f"{volume:.0f}",
                'formatted_price': formatted_price,
                'formatted_change': f"{change:+.2f}%",
                'asset_type': data.get('asset_type', 'unknown'),
                'type': data.get('asset_type', 'unknown').capitalize(),
                'signal_type': data.get('signal_type', 'HOLD'),
                'confidence': data.get('confidence', 0),
                'name': data.get('name', display_symbol)
            }
        except Exception as e:
            logger.error(f"Error adapting data for {symbol}: {e}")
            continue
            
    return adapted_data

def adapt_signals_for_frontend(real_market_data: Dict) -> Dict:
    """Transform REAL signals with accurate trading levels"""
    adapted_signals = {}
    current_time = time.time()
    
    for symbol, data in real_market_data.items():
        try:
            signal_type = data.get('signal_type')
            confidence = data.get('confidence', 0)
            current_price = data.get('price', 0)
            
            # Only show meaningful signals
            if signal_type in ['BUY', 'SELL'] and confidence >= 0.7 and current_price > 0:
                
                # Calculate REALISTIC trading levels based on volatility
                volatility = data.get('volatility', 1.0)
                risk_pct = 0.002 + (volatility / 100)  # Dynamic risk based on volatility
                reward_pct = risk_pct * 2  # 1:2 risk-reward
                
                if signal_type == 'BUY':
                    entry_price = round(current_price * (1 + 0.0002), 5)  # Slight slippage
                    stop_loss = round(current_price * (1 - risk_pct), 5)
                    take_profit = round(current_price * (1 + reward_pct), 5)
                else:  # SELL
                    entry_price = round(current_price * (1 - 0.0002), 5)  # Slight slippage
                    stop_loss = round(current_price * (1 + risk_pct), 5)
                    take_profit = round(current_price * (1 - reward_pct), 5)
                
                # Calculate pips/points
                if data.get('asset_type') == 'forex':
                    sl_pips = abs(entry_price - stop_loss) * 10000
                    tp_pips = abs(entry_price - take_profit) * 10000
                else:
                    sl_pips = abs((entry_price - stop_loss) / entry_price) * 10000
                    tp_pips = abs((entry_price - take_profit) / entry_price) * 10000
                
                risk_reward = round(tp_pips / sl_pips, 1) if sl_pips > 0 else 0
                
                signal_data = {
                    'symbol': symbol,
                    'display_symbol': symbol.replace('=X', '').replace('-USD', ''),
                    'signal_type': signal_type,
                    'confidence': confidence,
                    'formatted_confidence': f"{confidence:.1%}",
                    'current_price': current_price,
                    'entry_price': entry_price,
                    'stop_loss': stop_loss,
                    'take_profit': take_profit,
                    'sl_pips': round(sl_pips, 1),
                    'tp_pips': round(tp_pips, 1),
                    'risk_reward': risk_reward,
                    'formatted_rr': f"1:{risk_reward:.1f}",
                    'position_size': 0.02,
                    'timestamp': current_time,
                    'time_ago': 'Just now',
                    'asset_type': data.get('asset_type', 'unknown'),
                    'strength': 'ULTRA' if confidence >= 0.9 else 'Strong' if confidence >= 0.8 else 'Quality',
                    'badge_color': 'bg-success' if signal_type == 'BUY' else 'bg-danger',
                    'name': data.get('name', symbol.replace('=X', '').replace('-USD', ''))
                }
                
                adapted_signals[symbol] = signal_data
                
        except Exception as e:
            logger.error(f"Error adapting signal for {symbol}: {e}")
            continue
            
    return adapted_signals

def background_data_broadcast(update_all_func, app_instance, socketio_instance, dashboard_instance):
    """Background thread to broadcast REAL data"""
    logger.info("✅ Starting REAL-TIME data broadcast")
    
    while True:
        try:
            if dashboard_instance.connected_clients > 0:
                with app_instance.app_context():
                    response = update_all_func()
                    data = response.json
                
                socketio_instance.emit('market_update', data)
                logger.info(f"📊 Broadcasted REAL data to {dashboard_instance.connected_clients} clients")
                
            time.sleep(30)  # Update every 30 seconds
            
        except Exception as e:
            logger.error(f"Background broadcast error: {e}")
            time.sleep(10)

